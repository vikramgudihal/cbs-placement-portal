# ============================================================
# CBS 3i-CELL PLACEMENT CELL - PRODUCTION ENVIRONMENT CONFIG
# ============================================================

# Environment: 'production' or 'development'
FLASK_ENV=production
DEBUG=False

# Secure Random Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-very-long-and-secure-random-string-in-production

# MongoDB Connection String & Database Name
MONGO_URI=mongodb://localhost:27017
DB_NAME=placement_system

# Server Network Binding
HOST=0.0.0.0
PORT=5000

# Security Settings
# Set to 'True' once SSL certificate (HTTPS) is active on domain
SESSION_COOKIE_SECURE=False
TALISMAN_FORCE_HTTPS=False

# Rate Limiting & Max Upload Payload
MAX_CONTENT_LENGTH=16777216
RATELIMIT_STORAGE_URI=memory://
